{
  "name": "nest-scramble",
  "version": "5.0.0",
  "description": "A next-generation, decorator-free API documentation engine with Postman generation, live mocking, and typed client SDK generation for NestJS 10 and 11, engineered by Mohamed Mustafa",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nest-scramble": "dist/cli.js"
  },
  "files": [
    "dist/",
    "src/",
    "!src/examples/**",
    "!src/controllers/DemoController.ts",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eng-MMustafa/nest-scramble.git"
  },
  "homepage": "https://github.com/Eng-MMustafa/nest-scramble#readme",
  "bugs": {
    "url": "https://github.com/Eng-MMustafa/nest-scramble/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "verify:runtime-deps": "node scripts/verify-no-dev-deps-at-runtime.js",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:ci": "jest --coverage --coverageReporters=lcov --coverageReporters=text",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "watch-generate": "node scripts/watch-generate.js"
  },
  "keywords": [
    "nestjs",
    "nestjs-10",
    "nestjs-11",
    "documentation",
    "openapi",
    "swagger",
    "static-analysis",
    "ast",
    "postman",
    "mocking",
    "typed-client",
    "sdk-generator",
    "mohamed-mustafa",
    "typescript",
    "zero-config",
    "zero-decorator"
  ],
  "author": {
    "name": "Mohamed Mustafa",
    "url": "https://github.com/Eng-MMustafa"
  },
  "license": "MIT",
  "devDependencies": {
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-fastify": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "chokidar": "^3.5.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "chokidar": "^3.5.3 || ^4.0.0",
    "reflect-metadata": ">=0.1.13",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "chokidar": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  }
}
