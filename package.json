{
  "name": "nest-scramble",
  "version": "5.8.0",
  "description": "Zero-config API documentation for NestJS and Express: OpenAPI docs, live REST/WebSocket/GraphQL consoles, mock server, Postman export and typed SDK generation from static analysis — no decorators required",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nest-scramble": "dist/cli.js"
  },
  "files": [
    "dist/",
    "src/",
    "!src/examples/**",
    "!src/controllers/DemoController.ts",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eng-MMustafa/nest-scramble.git"
  },
  "homepage": "https://github.com/Eng-MMustafa/nest-scramble#readme",
  "bugs": {
    "url": "https://github.com/Eng-MMustafa/nest-scramble/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "verify:runtime-deps": "node scripts/verify-no-dev-deps-at-runtime.js",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:ci": "jest --coverage --coverageReporters=lcov --coverageReporters=text",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "watch-generate": "node scripts/watch-generate.js"
  },
  "keywords": [
    "nestjs",
    "nestjs-10",
    "nestjs-11",
    "express",
    "expressjs",
    "fastify",
    "nodejs",
    "api",
    "api-docs",
    "api-documentation",
    "documentation",
    "openapi",
    "openapi3",
    "swagger",
    "swagger-alternative",
    "scalar",
    "redoc",
    "rest",
    "websocket",
    "socket.io",
    "graphql",
    "static-analysis",
    "ast",
    "postman",
    "mock-server",
    "mocking",
    "typed-client",
    "sdk-generator",
    "contract-testing",
    "api-diff",
    "typescript",
    "zero-config",
    "zero-decorator",
    "mohamed-mustafa"
  ],
  "author": {
    "name": "Mohamed Mustafa",
    "url": "https://github.com/Eng-MMustafa"
  },
  "license": "MIT",
  "devDependencies": {
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-fastify": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "graphql": "^17.0.2",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": ">=0.1.13",
    "typescript": ">=5.0.0 <7"
  },
  "peerDependenciesMeta": {
    "reflect-metadata": {
      "optional": true
    }
  }
}
